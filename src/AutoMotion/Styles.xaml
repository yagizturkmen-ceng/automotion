<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:util="clr-namespace:AutoMotion.Utilities">

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- ============ GARANTİ SATIR YÜKSEKLİĞİ (tüm arayüz metinleri) ============
         Pixel font (Press Start 2P) dikey metriklerini yanlış bildiriyor: ascent=1000, descent=0
         diyor ama mürekkep taban çizgisinin 374/1000 em altına iniyor (ç/ş/ğ/g/y kuyrukları).
         WPF satır kutusunu bu yüzden gerçek mürekkepten kısa ölçüyor ve alt alta duran metinler
         birbirine biniyordu. Aynı hata dört ayrı yüzeyde ayrı ayrı yamanmıştı; artık TEK kural:
         her TextBlock, font boyutuyla orantılı ve mürekkebi içine alan bir satır yüksekliği alır
         (bkz. Utilities/PixelLineHeightConverter.cs).

         Örtük (x:Key'siz) stil olduğu için yeni eklenen TextBlock'lar da kendiliğinden korunur -
         düzeltmenin bir daha tek tek elle uygulanması gerekmez.

         MUTLAK KONUMLANDIRILAN metinler bu kuralın DIŞINDA: sahnedeki emoji/sprite'lar ve vites
         yuvası etiketleri Canvas.Top ile piksel hassasiyetinde yerleştiriliyor, satır kutusunu
         büyütmek onları kaydırırdı. O kanvaslar kendi kaynaklarında boş bir TextBlock stiliyle
         bu kuralı iptal eder (bkz. MainWindow.xaml: RenderCanvas, GearSlotLabelsCanvas). -->
    <util:PixelLineHeightConverter x:Key="PixelLineHeight"/>

    <Style x:Key="GuaranteedLineHeight" TargetType="TextBlock">
        <Setter Property="LineHeight"
                Value="{Binding RelativeSource={RelativeSource Self}, Path=FontSize, Converter={StaticResource PixelLineHeight}}"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>

    <Style TargetType="TextBlock" BasedOn="{StaticResource GuaranteedLineHeight}"/>

    <!-- ============ BEYTRIUM NEO-BRUTALIST COLOR PALETTE ============ -->
    <Color x:Key="BeykentYellowColor">#fbca1f</Color>
    <Color x:Key="BeykentBlueColor">#1ABCAA</Color>
    <Color x:Key="BeykentNavyColor">#001F5B</Color>
    <Color x:Key="LightBgColor">#FFFFCC</Color>
    <Color x:Key="DarkBgColor">#15202b</Color>
    <Color x:Key="TextBlackColor">#000000</Color>

    <SolidColorBrush x:Key="BeykentYellowBrush" Color="{StaticResource BeykentYellowColor}"/>
    <SolidColorBrush x:Key="BeykentBlueBrush" Color="{StaticResource BeykentBlueColor}"/>
    <SolidColorBrush x:Key="BeykentNavyBrush" Color="{StaticResource BeykentNavyColor}"/>
    <SolidColorBrush x:Key="LightBgBrush" Color="{StaticResource LightBgColor}"/>
    <SolidColorBrush x:Key="DarkBgBrush" Color="{StaticResource DarkBgColor}"/>
    <SolidColorBrush x:Key="TextBlackBrush" Color="{StaticResource TextBlackColor}"/>

    <!-- Legacy compatibility brushes - mapped to Neo-Brutalist palette -->
    <SolidColorBrush x:Key="NavyDeepBrush" Color="{StaticResource BeykentNavyColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource BeykentYellowColor}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource TextBlackColor}"/>
    <SolidColorBrush x:Key="WhiteSoftBrush" Color="#333333"/>

    <!-- Neo-Brutalist Solid Panel Background -->
    <SolidColorBrush x:Key="NavyPanelGradient" Color="{StaticResource DarkBgColor}"/>
    <SolidColorBrush x:Key="NeonBorderBrush" Color="{StaticResource TextBlackColor}"/>

    <!-- Gerçek 8-bit bitmap piksel font (Press Start 2P, SIL Open Font License) -
         projeye gömülü, Assets/Fonts altında. Panel başlıkları/rakamlar gibi kısa
         metinlerde kullanılır; uzun cümleler için hâlâ okunaklı gövde fontu kullanılır. -->
    <FontFamily x:Key="PixelFont">./Assets/Fonts/#Press Start 2P, Segoe UI Emoji</FontFamily>
    <FontFamily x:Key="BodyFont">./Assets/Fonts/#Press Start 2P, Segoe UI Emoji</FontFamily>

    <!-- ============ Neo-Brutalist ToolTip: butonların üzerine gelince arayüzün geri kalanıyla
         aynı koyu/sarı-vurgulu, keskin köşeli, piksel fontlu temayı kullanır (varsayılan beyaz
         Windows tooltip yerine). Implicit stil - tüm ToolTip="..." tanımlı butonlara otomatik uygulanır. -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="#FFE66D"/>
        <Setter Property="Background" Value="#0A1626"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource BeykentYellowBrush}" BorderThickness="2">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="0" ShadowDepth="3" Opacity="1" Direction="315"/>
                        </Border.Effect>
                        <TextBlock Text="{TemplateBinding Content}" Margin="{TemplateBinding Padding}"
                                   FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}"
                                   TextWrapping="Wrap" MaxWidth="220"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Konsolide Panel Menüsü: Beytrium temalı sekme (TabItem/TabControl) ============
         Tek bir "☰ Paneller" penceresinde İstatistik/Araç/Vites/Eşya/Hızlı İşlem/Eklenti sekmeleri
         birleştirildi - varsayılan WPF TabControl'ün beyaz/sistem görünümü yerine, uygulamanın geri
         kalanıyla tutarlı kalın-siyah-kenarlıklı, keskin köşeli, sarı-vurgulu sekme görünümü. -->
    <Style x:Key="BeytriumTabItem" TargetType="TabItem">
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
        <Setter Property="FontSize" Value="7"/>
        <Setter Property="Padding" Value="6,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="tabBd" Background="#0A1626" BorderBrush="{StaticResource TextBlackBrush}" BorderThickness="2,2,2,0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="#C9D6E8"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="tabBd" Property="Background" Value="{StaticResource BeykentYellowBrush}"/>
                            <Setter TargetName="tabBd" Property="TextBlock.Foreground" Value="#000000"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BeytriumTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TabPanel x:Name="HeaderPanel" Grid.Row="0" IsItemsHost="True" Panel.ZIndex="1"/>
                        <Border Grid.Row="1" Background="#0A1626" BorderBrush="{StaticResource TextBlackBrush}" BorderThickness="2">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Neo-Brutalist Modern Button ============ -->
    <Style x:Key="ModernButton" TargetType="Button">
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="Background" Value="{StaticResource BeykentYellowBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TextBlackBrush}"/>
        <Setter Property="BorderThickness" Value="4"/>
        <Setter Property="Padding" Value="10,9"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
        <Setter Property="ToolTipService.ShowDuration" Value="8000"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="transT" X="0" Y="0"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="shadow" Color="#000000" BlurRadius="0" ShadowDepth="4" Opacity="1" Direction="315"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="transT" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="transT" Storyboard.TargetProperty="Y" To="2" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="ShadowDepth" To="2" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="transT" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="transT" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="ShadowDepth" To="4" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="transT" Storyboard.TargetProperty="X" To="4" Duration="0:0:0.04"/>
                                        <DoubleAnimation Storyboard.TargetName="transT" Storyboard.TargetProperty="Y" To="4" Duration="0:0:0.04"/>
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="ShadowDepth" To="0" Duration="0:0:0.04"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="transT" Storyboard.TargetProperty="X" To="2" Duration="0:0:0.04"/>
                                        <DoubleAnimation Storyboard.TargetName="transT" Storyboard.TargetProperty="Y" To="2" Duration="0:0:0.04"/>
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="ShadowDepth" To="2" Duration="0:0:0.04"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Icon Button (dock + panel başlıkları) ============ -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="Background" Value="{StaticResource BeykentBlueBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TextBlackBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Margin" Value="3,0"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- Üstteki dock ikonları (Tema/Ses/Araç Ekle vb.) sadece emoji gösterdiğinden ToolTip'in
             ne işe yaradığını açıklaması kritik - varsayılan ~1sn'lik bekleme yerine daha hızlı
             (200ms) belirip daha uzun (8sn) açık kalması, "üstüne gelince ne olduğu görünsün"
             isteğini daha akıcı karşılıyor. -->
        <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
        <Setter Property="ToolTipService.ShowDuration" Value="8000"/>
        <Setter Property="ToolTipService.BetweenShowDelay" Value="50"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="transT" X="0" Y="0"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect x:Name="shadow" Color="#000000" BlurRadius="0" ShadowDepth="3" Opacity="1" Direction="315"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="transT" Storyboard.TargetProperty="X" To="1.5" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="transT" Storyboard.TargetProperty="Y" To="1.5" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="ShadowDepth" To="1.5" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="transT" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="transT" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.08"/>
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="ShadowDepth" To="3" Duration="0:0:0.08"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="transT" Storyboard.TargetProperty="X" To="3" Duration="0:0:0.04"/>
                                        <DoubleAnimation Storyboard.TargetName="transT" Storyboard.TargetProperty="Y" To="3" Duration="0:0:0.04"/>
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="ShadowDepth" To="0" Duration="0:0:0.04"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="transT" Storyboard.TargetProperty="X" To="1.5" Duration="0:0:0.04"/>
                                        <DoubleAnimation Storyboard.TargetName="transT" Storyboard.TargetProperty="Y" To="1.5" Duration="0:0:0.04"/>
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="ShadowDepth" To="1.5" Duration="0:0:0.04"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Icon Button - Close (Kırmızı Arka Plan) ============ -->
    <Style x:Key="IconButtonClose" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Background" Value="#FF4B4B"/>
        <Setter Property="Foreground" Value="#000000"/>
    </Style>

    <!-- ============ Neo-Brutalist ProgressBar ============ -->
    <Style x:Key="RoundedProgressBar" TargetType="ProgressBar">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="BorderBrush" Value="#000000"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0" ClipToBounds="True">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="0"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="0" HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Neo-Brutalist Slider (Ayarlar panelindeki çarpan kaydırıcıları) ============ -->
    <Style x:Key="ThemedSlider" TargetType="Slider">
        <Setter Property="Height" Value="22"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="10" Background="#0A1626" BorderBrush="#000000" BorderThickness="2" CornerRadius="0"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="10" Background="{StaticResource BeykentYellowBrush}" BorderBrush="#000000" BorderThickness="2,2,0,2"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0" Opacity="0"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="18">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{StaticResource BeykentYellowBrush}" BorderBrush="#000000" BorderThickness="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Neo-Brutalist CheckBox (Ayarlar panelindeki aç/kapa kutuları) ============ -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#CCD"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="14" Height="14" Background="#0A1626" BorderBrush="#000000" BorderThickness="2" Margin="0,0,6,0">
                            <Path Name="CheckMark" Data="M 1,5 L 4,9 L 11,1" Stroke="{StaticResource BeykentYellowBrush}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding Content}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Animated Panel (Neo-Brutalist Sert Görüntü) ============ -->
    <Style x:Key="AnimatedPanel" TargetType="Border">
        <Setter Property="BorderThickness" Value="4"/>
        <Setter Property="BorderBrush" Value="#000000"/>
        <Setter Property="Background" Value="{StaticResource DarkBgBrush}"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="0" ShadowDepth="8" Opacity="1" Direction="315"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3">
                            <DoubleAnimation.EasingFunction>
                                <QuadraticEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============ Sekme İçi Panel (Loaded-fade YOK) ============
         AnimatedPanel'in aynısı ama "Loaded" olduğunda Opacity'yi 0'dan başlatıp animasyonla
         yükselten tetikleyici YOK. Konsolide "☰ Paneller" sekmeli penceresine taşınan panellerde
         (İstatistik/Araç/Vites/Eşya/Hızlı/Eklenti) kullanılır: TabControl sekme değiştirdikçe
         içerikleri Unload/Load olur ve her seferinde bu tetikleyici yeniden ateşlenip Opacity'yi
         0'a resetliyordu - sekme sık değiştirildiğinde veya arka arkaya birden fazla Unload/Load
         olduğunda animasyon hiç tamamlanma fırsatı bulamayıp panel SÜREKLİ görünmez (Opacity≈0)
         kalabiliyordu (ör. Sürüş Modu'na girip Vites sekmesine geçildiğinde panel bomboş görünmesi). -->
    <Style x:Key="TabbedPanel" TargetType="Border">
        <Setter Property="BorderThickness" Value="4"/>
        <Setter Property="BorderBrush" Value="#000000"/>
        <Setter Property="Background" Value="{StaticResource DarkBgBrush}"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="0" ShadowDepth="8" Opacity="1" Direction="315"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Text Styles ============
         Adlandırılmış (x:Key'li) stiller örtük stili DEVRALMAZ - bu yüzden satır yüksekliği
         kuralını açıkça BasedOn ile alırlar. -->
    <Style x:Key="HeaderText" TargetType="TextBlock" BasedOn="{StaticResource GuaranteedLineHeight}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock" BasedOn="{StaticResource GuaranteedLineHeight}">
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
    </Style>

    <!-- ============ Beytrium Özel Scrollbar (Bölüm 4.4) ============ -->
    <Style x:Key="BeytriumScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource BeykentYellowBrush}" BorderBrush="#000000" BorderThickness="3" CornerRadius="999" Margin="2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BeykentBlueBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BeytriumScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource BeytriumScrollBarThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BeytriumScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter Grid.Column="0" Grid.Row="0"/>
                        <ScrollBar Name="PART_VerticalScrollBar" Grid.Column="1" Grid.Row="0"
                                   Style="{StaticResource BeytriumScrollBar}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        <ScrollBar Name="PART_HorizontalScrollBar" Grid.Column="0" Grid.Row="1" Orientation="Horizontal"
                                   Style="{StaticResource BeytriumScrollBar}"
                                   Value="{TemplateBinding HorizontalOffset}"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Neo-Brutalist Dikey Slider (Vites Kolu vb.) ============ -->
    <Style x:Key="NeoBrutalistSliderThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource BeykentYellowBrush}" BorderBrush="#000000" BorderThickness="3" CornerRadius="0"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="0" ShadowDepth="3" Opacity="1" Direction="315"/>
                        </Border.Effect>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource BeykentBlueBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="⠿" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="#000000" IsHitTestVisible="False"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NeoBrutalistVerticalSlider" TargetType="Slider">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Rectangle Width="6" Fill="#000000" HorizontalAlignment="Center" Margin="0,13"/>
                        <Track Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Opacity="0"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Opacity="0"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource NeoBrutalistSliderThumb}" Width="40" Height="26"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Glassmorphism TextBox Style -> Neo-Brutalist Input -->
    <Style x:Key="ModernTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="BorderBrush" Value="#000000"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="CaretBrush" Value="#000000"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0">
                        <ScrollViewer Name="PART_ContentHost" Margin="0"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Parola alanı: ModernTextBox'ın görsel ikizi. Ayrı bir kontrol (PasswordBox) olması şart -
         TextBox parolayı düz metin gösterir ve içeriğini bellekte sıradan bir string olarak tutar;
         MQTT broker parolası için (bkz. IoTTelemetryService) uygun olan PasswordBox'tır. -->
    <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="BorderBrush" Value="#000000"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="CaretBrush" Value="#000000"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0">
                        <ScrollViewer Name="PART_ContentHost" Margin="0"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
