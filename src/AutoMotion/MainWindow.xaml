                </ScrollViewer>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Bottom Right - Quick Actions -->
        <Border Name="QuickActionsPanel" Width="280" Padding="15" Style="{StaticResource AnimatedPanel}">
