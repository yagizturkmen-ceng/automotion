                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Name="QuickActionsPanelHeader" Background="Transparent" Cursor="SizeAll" Tag="{Binding ElementName=QuickActionsPanel}"
                                MouseLeftButtonDown="PanelHeader_MouseLeftButtonDown" MouseMove="PanelHeader_MouseMove" MouseLeftButtonUp="PanelHeader_MouseLeftButtonUp">
                        <TextBlock Text="⠿" FontSize="10" Foreground="#3DA9FC" Margin="0,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock Text="{loc:Translate ui.hizli_islemler_2}" FontFamily="{StaticResource PixelFont}" FontSize="8" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Name="QuickActionsCollapseBtn" Content="⏵" Click="PanelBody_Toggle" Tag="{Binding ElementName=QuickActionsScrollViewer}" Style="{StaticResource IconButton}" Width="20" Height="20" Margin="1,0" FontSize="10" ToolTip="{loc:Translate ui.kucult_buyut}" AutomationProperties.Name="{loc:Translate ui.kucult_buyut}"/>
                        <Button Name="QuickActionsScaleDownBtn" Content="➖" Click="PanelScaleDown_Click" Tag="{Binding ElementName=QuickActionsPanel}" Style="{StaticResource IconButton}" Width="20" Height="20" Margin="1,0" FontSize="10" ToolTip="{loc:Translate ui.paneli_kucult}" AutomationProperties.Name="{loc:Translate ui.paneli_kucult}"/>
                        <Button Name="QuickActionsScaleUpBtn" Content="➕" Click="PanelScaleUp_Click" Tag="{Binding ElementName=QuickActionsPanel}" Style="{StaticResource IconButton}" Width="20" Height="20" Margin="1,0" FontSize="10" ToolTip="{loc:Translate ui.paneli_buyut}" AutomationProperties.Name="{loc:Translate ui.paneli_buyut}"/>
                        <Button Name="QuickActionsPinBtn" Content="📌" Click="PanelPin_Click" Tag="{Binding ElementName=QuickActionsPanel}" Style="{StaticResource IconButton}" Width="20" Height="20" Margin="1,0" FontSize="10" ToolTip="{loc:Translate ui.sabitle}" AutomationProperties.Name="{loc:Translate ui.sabitle}"/>
                        <Button Name="QuickActionsDetachBtn" Content="↗️" Click="PanelDetach_Click" Tag="{Binding ElementName=QuickActionsPanel}" Style="{StaticResource IconButton}" Width="20" Height="20" Margin="1,0" FontSize="10" ToolTip="{loc:Translate ui.panelden_ayir_bagimsiz_pencereye_cikar}" AutomationProperties.Name="{loc:Translate ui.panelden_ayir}"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Name="QuickActionsScrollViewer" MaxHeight="560" VerticalScrollBarVisibility="Auto" Style="{StaticResource BeytriumScrollViewer}" Visibility="Collapsed">
                <StackPanel Name="QuickActionsPanelBody">
                <Button Name="SpawnVehicleQuickBtn" Content="{loc:Translate ui.arac_dogur}" Click="AddVehicleBtn_Click" Style="{StaticResource ModernButton}" Margin="0,3" ToolTip="{loc:Translate ui.yeni_bir_arac_ekle_r}"/>
                <Button Name="CallVehicleQuickBtn" Content="{loc:Translate ui.arac_cagir}" Click="CallVehicleBtn_Click" Style="{StaticResource ModernButton}" Margin="0,3" ToolTip="{loc:Translate ui.secili_araci_imlece_cagir_q_2}"/>
                <Button Name="ImportCustomVehicleBtn" Content="{loc:Translate ui.kendi_aracini_ekle}" Click="ImportCustomVehicleBtn_Click" Style="{StaticResource ModernButton}" Margin="0,3" ToolTip="{loc:Translate ui.kendi_arac_gorselini_beyaz_arkaplanli_ice}"/>

                <Rectangle Height="1.2" Fill="#333DA9FC" Margin="0,7"/>

                <TextBlock Text="{loc:Translate ui.magaza}" FontFamily="{StaticResource PixelFont}" FontSize="10" FontWeight="Bold" Foreground="#fbca1f" Margin="0,0,0,5"/>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Name="AddFuelBtn" Content="{loc:Translate ui.yakit_10}" Click="AddFuelBtn_Click" Style="{StaticResource ModernButton}" FontSize="8" Padding="4,7" Margin="0,0,3,0"/>
                    <Button Name="AddRepairBtn" Content="{loc:Translate ui.onarim_30}" Click="AddRepairBtn_Click" Style="{StaticResource ModernButton}" FontSize="8" Padding="4,7" Grid.Column="1" Margin="3,0,0,0"/>
                </Grid>
                <TextBlock Text="{loc:Translate ui.yukseltmeler}" FontSize="9" Foreground="#889" Margin="1,4,0,2"/>
                <UniformGrid Columns="2" Margin="0,0,0,3">
                    <Button Content="🚀 $100" Click="BuyUpgradeBtn_Click" Tag="speed" Style="{StaticResource ModernButton}" FontSize="8" BorderThickness="2" Padding="2,5" Margin="1" ToolTip="{loc:Translate ui.hiz_upgradi_20}"/>
                    <Button Content="⚡ $80" Click="BuyUpgradeBtn_Click" Tag="acceleration" Style="{StaticResource ModernButton}" FontSize="8" BorderThickness="2" Padding="2,5" Margin="1" ToolTip="{loc:Translate ui.hizlanma_upgradi_15}"/>
                    <Button Content="💚 $60" Click="BuyUpgradeBtn_Click" Tag="efficiency" Style="{StaticResource ModernButton}" FontSize="8" BorderThickness="2" Padding="2,5" Margin="1" ToolTip="{loc:Translate ui.verimlilik_upgradi_25}"/>
                    <Button Content="💪 $90" Click="BuyUpgradeBtn_Click" Tag="durability" Style="{StaticResource ModernButton}" FontSize="8" BorderThickness="2" Padding="2,5" Margin="1" ToolTip="{loc:Translate ui.dayaniklilik_upgradi_30}"/>
                </UniformGrid>
                <TextBlock Text="{loc:Translate ui.dekorasyonlar}" FontSize="9" Foreground="#889" Margin="1,4,0,2"/>
                <UniformGrid Columns="2" Margin="0,0,0,3">
                    <Button Content="🎨 $20" Click="BuyDecorationBtn_Click" Tag="paint" Style="{StaticResource ModernButton}" FontSize="8" BorderThickness="2" Padding="2,5" Margin="1" ToolTip="{loc:Translate ui.boya}"/>
                    <Button Content="✨ $15" Click="BuyDecorationBtn_Click" Tag="sticker" Style="{StaticResource ModernButton}" FontSize="8" BorderThickness="2" Padding="2,5" Margin="1" ToolTip="{loc:Translate ui.sticker_rozet}"/>
                    <Button Content="🏎️ $50" Click="BuyDecorationBtn_Click" Tag="spoiler" Style="{StaticResource ModernButton}" FontSize="8" BorderThickness="2" Padding="2,5" Margin="1" ToolTip="{loc:Translate ui.spoiler}"/>
                    <Button Content="💡 $40" Click="BuyDecorationBtn_Click" Tag="lights" Style="{StaticResource ModernButton}" FontSize="8" BorderThickness="2" Padding="2,5" Margin="1" ToolTip="{loc:Translate ui.led_isik_guclu_glow}"/>
                </UniformGrid>

                <Rectangle Height="1.2" Fill="#333DA9FC" Margin="0,7"/>

                <!-- Ayarlar: kirlenme/yakıt gibi genel oyun çarpanları - varsayılan olarak katlı. -->
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="{loc:Translate ui.ayarlar}" FontFamily="{StaticResource PixelFont}" FontSize="10" FontWeight="Bold" Foreground="#fbca1f"/>
                    <Button Name="SettingsToggleBtn" Content="⏵" Click="PanelBody_Toggle" Tag="{Binding ElementName=SettingsBody}" Style="{StaticResource IconButton}" Width="22" Height="22" HorizontalAlignment="Right" ToolTip="{loc:Translate ui.ac_kapa}" AutomationProperties.Name="{loc:Translate ui.ac_kapa}"/>
                </Grid>
                <StackPanel Name="SettingsBody" Visibility="Collapsed">
                    <StackPanel.Resources>
                        <!-- Ayar etiketlerinin ortak stili. Satır yüksekliği garantisi artık
                             uygulama genelindeki tek kuraldan geliyor (bkz. Styles.xaml
                             GuaranteedLineHeight); burada elle LineHeight verilmiyor. -->
                        <Style x:Key="SettingLabel" TargetType="TextBlock" BasedOn="{StaticResource GuaranteedLineHeight}">
                            <Setter Property="FontSize" Value="9"/>
                            <Setter Property="Foreground" Value="#889"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="Margin" Value="1,6,0,3"/>
                        </Style>
                    </StackPanel.Resources>

                    <!-- Dil seçimi: tepsi menüsünde de var, ama Steam oyuncusu dili AYARLAR altında
                         arar - burada olması keşfedilebilirliği belirgin şekilde artırıyor. Seçim
                         anında uygulanır, yeniden başlatma gerekmez (bkz. Services/Localization.cs). -->
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Translate ui.dil}" FontSize="10" Foreground="#CCD" VerticalAlignment="Center"/>
                        <ComboBox Name="LanguageCombo" Grid.Column="1" Width="110" SelectionChanged="LanguageCombo_SelectionChanged"
                                  ToolTip="{loc:Translate ui.arayuz_dilini_degistir}" AutomationProperties.Name="{loc:Translate ui.dil}"/>
                    </Grid>

                    <!-- Ses seviyeleri: eski ses sistemi yalnızca topyekûn sustur sunuyordu.
                         Ana/Efekt/Müzik ayrımı ticari bir oyunda standart beklentidir. -->
                    <TextBlock Text="{loc:Translate ui.ses_seviyeleri}" Style="{StaticResource SettingLabel}" Margin="1,10,0,4" Foreground="#AAB"/>

                    <TextBlock Style="{StaticResource SettingLabel}">
                        <Run Text="{loc:Translate ui.ana_ses}"/><Run Name="MasterVolumeTxt" Text="80%"/>
                    </TextBlock>
                    <Slider Name="MasterVolumeSlider" Style="{StaticResource ThemedSlider}" Minimum="0" Maximum="1" Value="0.8" SmallChange="0.05" LargeChange="0.1" ValueChanged="MasterVolumeSlider_ValueChanged" ToolTip="{loc:Translate ui.tum_seslerin_genel_seviyesi}" AutomationProperties.Name="{loc:Translate ui.ana_ses}"/>

                    <TextBlock Style="{StaticResource SettingLabel}">
                        <Run Text="{loc:Translate ui.efekt_sesi}"/><Run Name="SfxVolumeTxt" Text="85%"/>
                    </TextBlock>
                    <Slider Name="SfxVolumeSlider" Style="{StaticResource ThemedSlider}" Minimum="0" Maximum="1" Value="0.85" SmallChange="0.05" LargeChange="0.1" ValueChanged="SfxVolumeSlider_ValueChanged" ToolTip="{loc:Translate ui.motor_korna_carpisma_gibi_efektler}" AutomationProperties.Name="{loc:Translate ui.efekt_sesi}"/>

                    <CheckBox Name="DirtEffectCheckBox" Content="{loc:Translate ui.kirlenme_efekti}" Foreground="#CCD" FontSize="10" Margin="0,8,0,3" Click="DirtEffectCheckBox_Click" ToolTip="{loc:Translate ui.arac_govdesinde_kirlilik_arttikca_camur_lekesi}"/>

                    <TextBlock Style="{StaticResource SettingLabel}">
                        <Run Text="{loc:Translate ui.kirlilik_carpani}"/><Run Name="DirtMultiplierTxt" Text="1.0x"/>
                    </TextBlock>
                    <Slider Name="DirtMultiplierSlider" Style="{StaticResource ThemedSlider}" Minimum="0" Maximum="3" Value="1" SmallChange="0.1" LargeChange="0.5" ValueChanged="DirtMultiplierSlider_ValueChanged" ToolTip="{loc:Translate ui.araclarin_ne_hizda_kirlenecegini_olcekler_0}"/>

                    <TextBlock Style="{StaticResource SettingLabel}">
                        <Run Text="{loc:Translate ui.yakit_tuketimi_carpani}"/><Run Name="FuelMultiplierTxt" Text="1.0x"/>
                    </TextBlock>
                    <Slider Name="FuelMultiplierSlider" Style="{StaticResource ThemedSlider}" Minimum="0" Maximum="3" Value="1" SmallChange="0.1" LargeChange="0.5" ValueChanged="FuelMultiplierSlider_ValueChanged" ToolTip="{loc:Translate ui.araclarin_ne_hizda_yakit_tuketecegini_olcekler}"/>
                </StackPanel>

                <Rectangle Height="1.2" Fill="#333DA9FC" Margin="0,7"/>

                <!-- Ortam/olay butonları (8 tane) varsayılan olarak katlı - panel her zaman uzun
                     ve dağınık durmasın diye. İhtiyaç oldukça tek tıkla açılabiliyor. -->
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="{loc:Translate ui.ortam_amp_olaylar}" FontFamily="{StaticResource PixelFont}" FontSize="10" FontWeight="Bold" Foreground="#fbca1f"/>
                    <Button Name="EnvironmentEventsToggleBtn" Content="⏵" Click="PanelBody_Toggle" Tag="{Binding ElementName=EnvironmentEventsBody}" Style="{StaticResource IconButton}" Width="22" Height="22" HorizontalAlignment="Right" ToolTip="{loc:Translate ui.ac_kapa}" AutomationProperties.Name="{loc:Translate ui.ac_kapa}"/>
                </Grid>
                <StackPanel Name="EnvironmentEventsBody" Visibility="Collapsed">
                    <!-- Bu bölüm tek başına da kaydırılabilir: dış ScrollViewer'ın MaxHeight'ı diğer
                         açık bölümlerle (Ayarlar vb.) birlikte dolduğunda buradaki butonların bir
                         kısmı görünmeden kalmasın diye kendi sınırlı yüksekliği ve kaydırma çubuğu var. -->
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" Style="{StaticResource BeytriumScrollViewer}">
                    <StackPanel>
                    <Button Name="ToggleRainBtn" Content="{loc:Translate ui.yagmur_baslat_durdur}" Click="ToggleRainBtn_Click" Style="{StaticResource ModernButton}" Margin="0,3"/>
                    <Button Name="ToggleSnowBtn" Content="{loc:Translate ui.kar_baslat_durdur}" Click="ToggleSnowBtn_Click" Style="{StaticResource ModernButton}" Margin="0,3" ToolTip="{loc:Translate ui.kis_temali_hava_durumu_yagmurla_ayni}"/>
                    <Button Name="AddTrafficLightBtn" Content="{loc:Translate ui.trafik_isigi_yerlestir}" Click="AddTrafficLightBtn_Click" Style="{StaticResource ModernButton}" Margin="0,3"/>
                    <Button Name="AddStationBtn" Content="{loc:Translate ui.istasyon_yerlestir}" Click="AddStationBtn_Click" Style="{StaticResource ModernButton}" Margin="0,3" ToolTip="{loc:Translate ui.yakinina_gelen_araclari_otomatik_yakit_doldurur}"/>
                    <Button Name="AddConeBtn" Content="{loc:Translate ui.yol_calismasi_ekle}" Click="AddConeBtn_Click" Style="{StaticResource ModernButton}" Margin="0,3" ToolTip="{loc:Translate ui.yakinindan_gecen_araclari_yavaslatir}"/>
                    <Button Name="AddPoliceBtn" Content="{loc:Translate ui.trafik_polisi_ekle}" Click="AddPoliceBtn_Click" Style="{StaticResource ModernButton}" Margin="0,3" ToolTip="{loc:Translate ui.yolu_keser_bakimi_dusuk_hp_lt}"/>
                    <Button Name="AddRecycleTruckBtn" Content="{loc:Translate ui.geri_donusum_kamyonu}" Click="AddRecycleTruckBtn_Click" Style="{StaticResource ModernButton}" Margin="0,3" ToolTip="{loc:Translate ui.gorsel_bir_olay_gercek_geri_donusum}"/>
                    <Button Name="AddFuelCanBtn" Content="{loc:Translate ui.bidonla_manuel_doldur}" Click="AddFuelCanBtn_Click" Style="{StaticResource ModernButton}" Margin="0,3" ToolTip="{loc:Translate ui.bidonu_al_bir_araca_tikla_iptal}"/>
                    <Button Name="StartCargoBtn" Content="{loc:Translate ui.kargo_gorevi_baslat}" Click="StartCargoBtn_Click" Style="{StaticResource ModernButton}" Margin="0,3"/>
                    </StackPanel>
                    </ScrollViewer>
                </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Eklentiler Paneli - 🧩 dock butonuyla aç/kapa -->
        <Border Name="ExpansionsPanel" Width="320" Padding="15" Style="{StaticResource AnimatedPanel}" Visibility="Collapsed" Opacity="0">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Name="ExpansionsPanelHeader" Background="Transparent" Cursor="SizeAll" Tag="{Binding ElementName=ExpansionsPanel}"
                                MouseLeftButtonDown="PanelHeader_MouseLeftButtonDown" MouseMove="PanelHeader_MouseMove" MouseLeftButtonUp="PanelHeader_MouseLeftButtonUp">
                        <TextBlock Text="⠿" FontSize="10" Foreground="#3DA9FC" Margin="0,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock Text="{loc:Translate ui.eklentiler}" FontFamily="{StaticResource PixelFont}" FontSize="8" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Name="ExpansionsScaleDownBtn" Content="➖" Click="PanelScaleDown_Click" Tag="{Binding ElementName=ExpansionsPanel}" Style="{StaticResource IconButton}" Width="20" Height="20" Margin="1,0" FontSize="10" ToolTip="{loc:Translate ui.paneli_kucult}" AutomationProperties.Name="{loc:Translate ui.paneli_kucult}"/>
                        <Button Name="ExpansionsScaleUpBtn" Content="➕" Click="PanelScaleUp_Click" Tag="{Binding ElementName=ExpansionsPanel}" Style="{StaticResource IconButton}" Width="20" Height="20" Margin="1,0" FontSize="10" ToolTip="{loc:Translate ui.paneli_buyut}" AutomationProperties.Name="{loc:Translate ui.paneli_buyut}"/>
                        <Button Name="ExpansionsPinBtn" Content="📌" Click="PanelPin_Click" Tag="{Binding ElementName=ExpansionsPanel}" Style="{StaticResource IconButton}" Width="20" Height="20" Margin="1,0" FontSize="10" ToolTip="{loc:Translate ui.sabitle}" AutomationProperties.Name="{loc:Translate ui.sabitle}"/>
                        <Button Name="ExpansionsDetachBtn" Content="↗️" Click="PanelDetach_Click" Tag="{Binding ElementName=ExpansionsPanel}" Style="{StaticResource IconButton}" Width="20" Height="20" Margin="1,0" FontSize="10" ToolTip="{loc:Translate ui.panelden_ayir_bagimsiz_pencereye_cikar}" AutomationProperties.Name="{loc:Translate ui.panelden_ayir}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{loc:Translate ui.araclara_ekstra_davranislar_ozellikler_ekler_sonradan}" FontSize="10" Foreground="#C9D6E8" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <ItemsControl Name="ExpansionsListControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#12233F" BorderThickness="2" BorderBrush="#000000" CornerRadius="0" Padding="12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <!-- Eklenti adı ve açıklaması: ad satırı panel genişliğini aşınca
                                         kırpılıyordu ("Otomatik Tra...", "Kargo Görevle..."), sarılan
                                         açıklama satırları da birbirinin üstüne biniyordu. Sarma
                                         burada, satır yüksekliği garantisi ise uygulama genelindeki
                                         tek kuralda (bkz. Styles.xaml GuaranteedLineHeight). -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#C9D6E8" TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="{Binding StatusIcon}" Click="ExpansionToggle_Click" Tag="{Binding Id}"
                                            Style="{StaticResource IconButton}" Width="34" Height="34" VerticalAlignment="Center" ToolTip="{Binding StatusLabel}" AutomationProperties.Name="{Binding StatusLabel}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Rectangle Height="2" Fill="#000000" Margin="0,12,0,10"/>

                <!-- IoT/MQTT Telemetri Yayını: isteğe bağlı, varsayılan kapalı. Kullanıcının kendi
                     MQTT broker'ına (ör. yerel Home Assistant/Mosquitto) filo telemetrisi yayınlar.
                     Gerçek bir donanım/broker gerektirdiğinden ve bu ortamda test edilecek fiziksel
                     bir broker bulunmadığından, bağlantı/yayın hataları sessizce ele alınır (bkz.
                     Services/IoTTelemetryService.cs) - başarısızlık oyunun geri kalanını etkilemez. -->
                <TextBlock Text="{loc:Translate ui.iot_mqtt_telemetri_deneysel}" FontSize="10" FontWeight="Bold" Foreground="#3DA9FC" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="{loc:Translate ui.filo_verisini_arac_sayisi_para_mesafe}" FontSize="9" Foreground="#C9D6E8" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBox Name="IoTBrokerBox" Text="{loc:Translate ui.localhost_1883}" Style="{StaticResource ModernTextBox}" FontSize="10" Margin="0,0,0,6"
                         ToolTip="{loc:Translate ui.iot_broker_ipucu}"/>
                <TextBox Name="IoTTopicBox" Text="{loc:Translate ui.automotion_telemetry}" Style="{StaticResource ModernTextBox}" FontSize="10" Margin="0,0,0,6"/>

                <!-- Güvenlik (P1-6): bağlantı eskiden HER ZAMAN şifresiz ve kimlik doğrulamasızdı.
                     MQTT'de kullanıcı adı/parola CONNECT paketinde açık metin taşındığından, kimlik
                     bilgisi girildiğinde TLS olmadan bağlanmak kullanıcıya açıkça uyarılır
                     (bkz. IoTConnectBtn_Click). -->
                <CheckBox Name="IoTUseTlsCheck" Content="{loc:Translate ui.iot_tls_kullan}" Margin="0,2,0,4"
                          Click="IoTUseTlsCheck_Click" ToolTip="{loc:Translate ui.iot_tls_ipucu}"/>
                <CheckBox Name="IoTAllowUntrustedCheck" Content="{loc:Translate ui.iot_sertifika_dogrulamasini_atla}" Margin="14,0,0,6"
                          IsEnabled="False" ToolTip="{loc:Translate ui.iot_sertifika_ipucu}"/>

                <!-- Kimlik bilgileri isteğe bağlı: boş bırakılırsa anonim bağlanılır (broker izin
                     veriyorsa). Parola diske YAZILMAZ - her oturumda yeniden girilir; adres, konu,
                     kullanıcı adı ve TLS tercihleri settings.json'da saklanır. -->
                <TextBlock Text="{loc:Translate ui.iot_kullanici_adi}" FontSize="9" Foreground="#889" Margin="1,2,0,2"/>
                <TextBox Name="IoTUsernameBox" Style="{StaticResource ModernTextBox}" FontSize="10" Margin="0,0,0,6"
                         ToolTip="{loc:Translate ui.iot_kullanici_adi_ipucu}" AutomationProperties.Name="{loc:Translate ui.iot_kullanici_adi}"/>

                <TextBlock Text="{loc:Translate ui.iot_parola}" FontSize="9" Foreground="#889" Margin="1,0,0,2"/>
                <PasswordBox Name="IoTPasswordBox" Style="{StaticResource ModernPasswordBox}" FontSize="10" Margin="0,0,0,6"
                             ToolTip="{loc:Translate ui.iot_parola_ipucu}" AutomationProperties.Name="{loc:Translate ui.iot_parola}"/>

                <Button Name="IoTConnectBtn" Content="{loc:Translate ui.baglan}" Click="IoTConnectBtn_Click" Style="{StaticResource ModernButton}" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                <TextBlock Name="IoTStatusTxt" Text="{loc:Translate ui.bagli_degil}" FontSize="9" Foreground="#C9D6E8" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Tek Konsolide Menü: eskiden ekranın altı ayrı köşesine dağılmış paneller (İstatistikler,
             Seçili Araç, Vites, Eşyalar, Hızlı İşlemler, Eklentiler) kalabalık durmasın diye TEK bir
             sekmeli pencerede toplanıyor. Sekme içerikleri KOPYA değil - o panellerin AYNI (referans)
             Border'ları uygulama başlarken kod tarafında (bkz. MainWindow.xaml.cs
             MoveConsolidatedPanelsIntoTabs) buraya taşınıyor, böylece sürükleme/sabitleme/küçültme
             ve tüm veri bağlamaları birebir eskisi gibi çalışmaya devam ediyor. -->
        <Border Name="MasterPanel" Width="340" Padding="15" Style="{StaticResource AnimatedPanel}">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Name="MasterPanelHeader" Background="Transparent" Cursor="SizeAll" Tag="{Binding ElementName=MasterPanel}"
                                MouseLeftButtonDown="PanelHeader_MouseLeftButtonDown" MouseMove="PanelHeader_MouseMove" MouseLeftButtonUp="PanelHeader_MouseLeftButtonUp">
                        <TextBlock Text="⠿" FontSize="10" Foreground="#3DA9FC" Margin="0,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock Text="{loc:Translate ui.paneller}" FontFamily="{StaticResource PixelFont}" FontSize="8" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Name="MasterScaleDownBtn" Content="➖" Click="PanelScaleDown_Click" Tag="{Binding ElementName=MasterPanel}" Style="{StaticResource IconButton}" Width="20" Height="20" Margin="1,0" FontSize="10" ToolTip="{loc:Translate ui.paneli_kucult}" AutomationProperties.Name="{loc:Translate ui.paneli_kucult}"/>
                        <Button Name="MasterScaleUpBtn" Content="➕" Click="PanelScaleUp_Click" Tag="{Binding ElementName=MasterPanel}" Style="{StaticResource IconButton}" Width="20" Height="20" Margin="1,0" FontSize="10" ToolTip="{loc:Translate ui.paneli_buyut}" AutomationProperties.Name="{loc:Translate ui.paneli_buyut}"/>
                        <Button Name="MasterPinBtn" Content="📌" Click="PanelPin_Click" Tag="{Binding ElementName=MasterPanel}" Style="{StaticResource IconButton}" Width="20" Height="20" Margin="1,0" FontSize="10" ToolTip="{loc:Translate ui.sabitle}" AutomationProperties.Name="{loc:Translate ui.sabitle}"/>
                    </StackPanel>
                </Grid>

                <TabControl Name="MasterTabControl" Style="{StaticResource BeytriumTabControl}">
                    <TabItem Name="TabStats" Header="{loc:Translate ui.istatistik}" Style="{StaticResource BeytriumTabItem}"/>
                    <TabItem Name="TabVehicle" Header="{loc:Translate ui.arac_2}" Style="{StaticResource BeytriumTabItem}"/>
                    <TabItem Name="TabGear" Header="{loc:Translate ui.vites_2}" Style="{StaticResource BeytriumTabItem}"/>
                    <TabItem Name="TabShop" Header="{loc:Translate ui.esya}" Style="{StaticResource BeytriumTabItem}"/>
                    <TabItem Name="TabQuick" Header="{loc:Translate ui.hizli}" Style="{StaticResource BeytriumTabItem}"/>
                    <TabItem Name="TabExpansions" Header="{loc:Translate ui.eklenti}" Style="{StaticResource BeytriumTabItem}"/>
                </TabControl>
            </StackPanel>
        </Border>

        </Canvas>

        <!-- Bildirim/Uyarı Toast'u (yakıt/hasar/başarım bildirimleri) -->
        <Border Name="ToastPanel" Background="#F0001F5B" BorderThickness="3" BorderBrush="#000000" CornerRadius="0"
                Padding="14,10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
                Opacity="0" IsHitTestVisible="False" MaxWidth="320">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="0" ShadowDepth="4" Opacity="0.6"/>
            </Border.Effect>
            <TextBlock Name="ToastText" Text="" FontFamily="{StaticResource PixelFont}" FontSize="9" FontWeight="Bold" Foreground="#fbca1f" TextWrapping="Wrap"/>
        </Border>

        <!-- Araç Seçme ve Ekleme Modali (Vehicle Spawn Modal) - Galeri Düzeni -->
        <Grid Name="SpawnModal" Visibility="Collapsed" Background="#90000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Name="SpawnModalBox" Width="920" Height="600" Background="#FFFFCC" CornerRadius="0" BorderThickness="4" BorderBrush="#000000" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="0" ShadowDepth="8" Opacity="1" Color="#000000" Direction="315"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock TextWrapping="Wrap" Text="{loc:Translate ui.arac_paketi_ve_ekipman_galerisi}" FontFamily="{StaticResource PixelFont}" FontSize="9" FontWeight="Black" Foreground="#000000" HorizontalAlignment="Center"/>
                        <Button Content="✕" Click="CloseSpawnModal_Click" Style="{StaticResource IconButton}" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- İki Sütunlu Galeri: Sol = Araç Paketi, Sağ = Ekipman/Dorse Galerisi -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- SOL: Araç Paketi -->
                        <Border Grid.Column="0" Background="#EDEDF5" BorderThickness="3" BorderBrush="#000000">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="#001F5B" BorderThickness="0,0,0,3" BorderBrush="#000000" Padding="10,8">
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Translate ui.arac_paketi_butun_araclar}" FontFamily="{StaticResource PixelFont}" FontSize="8" FontWeight="Black" Foreground="#fbca1f" HorizontalAlignment="Center"/>
                                </Border>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource BeytriumScrollViewer}">
                                    <StackPanel Margin="10">

                                        <TextBlock Text="{loc:Translate ui.otomobiller}" FontFamily="{StaticResource PixelFont}" FontSize="10" FontWeight="Bold" Foreground="#001F5B" Margin="2,4,0,4"/>
                                        <WrapPanel>
                                            <Button Style="{StaticResource ModernButton}" Margin="4" Padding="6" Width="130" Height="90" Click="SpawnVehicleSelect_Click" Tag="car|sedan">
                                                <StackPanel><Image Source="pack://siteoforigin:,,,/Assets/Vehicles/car/car_sedan.png" Stretch="Uniform" Height="42"/><TextBlock Text="{loc:Translate ui.sedan}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource ModernButton}" Margin="4" Padding="6" Width="130" Height="90" Click="SpawnVehicleSelect_Click" Tag="car|sport">
                                                <StackPanel><Image Source="pack://siteoforigin:,,,/Assets/Vehicles/car/car_sport.png" Stretch="Uniform" Height="42"/><TextBlock Text="{loc:Translate ui.spor_sedan}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource ModernButton}" Margin="4" Padding="6" Width="130" Height="90" Click="SpawnVehicleSelect_Click" Tag="car|luxury">
                                                <StackPanel><Image Source="pack://siteoforigin:,,,/Assets/Vehicles/car/car_luxury.png" Stretch="Uniform" Height="42"/><TextBlock Text="{loc:Translate ui.luks_sedan}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel>
                                            </Button>
                                        </WrapPanel>

                                        <TextBlock Text="{loc:Translate ui.agir_vasita_cekiciler}" FontFamily="{StaticResource PixelFont}" FontSize="10" FontWeight="Bold" Foreground="#001F5B" Margin="2,10,0,4"/>
                                        <WrapPanel>
                                            <Button Style="{StaticResource ModernButton}" Margin="4" Padding="6" Width="130" Height="90" Click="SpawnVehicleSelect_Click" Tag="truck|hauler">
                                                <StackPanel><Image Source="pack://siteoforigin:,,,/Assets/Vehicles/truck/truck_hauler.png" Stretch="Uniform" Height="42"/><TextBlock Text="{loc:Translate ui.uzun_yol_cekicisi}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource ModernButton}" Margin="4" Padding="6" Width="130" Height="90" Click="SpawnVehicleSelect_Click" Tag="truck|rig">
                                                <StackPanel><Image Source="pack://siteoforigin:,,,/Assets/Vehicles/truck/truck_rig.png" Stretch="Uniform" Height="42"/><TextBlock Text="{loc:Translate ui.agir_vasita_cekici}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource ModernButton}" Margin="4" Padding="6" Width="130" Height="90" Click="SpawnVehicleSelect_Click" Tag="truck|freight">
                                                <StackPanel><Image Source="pack://siteoforigin:,,,/Assets/Vehicles/truck/truck_freight.png" Stretch="Uniform" Height="42"/><TextBlock Text="{loc:Translate ui.yuk_cekicisi}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel>
                                            </Button>
                                        </WrapPanel>

                                        <TextBlock Text="{loc:Translate ui.motosiklet_ve_bisiklet}" FontFamily="{StaticResource PixelFont}" FontSize="10" FontWeight="Bold" Foreground="#001F5B" Margin="2,10,0,4"/>
                                        <WrapPanel>
                                            <Button Style="{StaticResource ModernButton}" Margin="4" Padding="6" Width="130" Height="90" Click="SpawnVehicleSelect_Click" Tag="motorcycle|sport">
                                                <StackPanel><Image Source="pack://siteoforigin:,,,/Assets/Vehicles/motorcycle/motorcycle_sport.png" Stretch="Uniform" Height="42"/><TextBlock Text="{loc:Translate ui.spor_motosiklet}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource ModernButton}" Margin="4" Padding="6" Width="130" Height="90" Click="SpawnVehicleSelect_Click" Tag="motorcycle|race">
                                                <StackPanel><Image Source="pack://siteoforigin:,,,/Assets/Vehicles/motorcycle/motorcycle_race.png" Stretch="Uniform" Height="42"/><TextBlock Text="{loc:Translate ui.yaris_motosikleti}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel>
                                            </Button>
                                        </WrapPanel>

                                        <TextBlock Text="{loc:Translate ui.otobusler}" FontFamily="{StaticResource PixelFont}" FontSize="10" FontWeight="Bold" Foreground="#001F5B" Margin="2,10,0,4"/>
                                        <WrapPanel>
                                            <Button Style="{StaticResource ModernButton}" Margin="4" Padding="6" Width="130" Height="90" Click="SpawnVehicleSelect_Click" Tag="bus|coach">
                                                <StackPanel><Image Source="pack://siteoforigin:,,,/Assets/Vehicles/bus/bus_coach.png" Stretch="Uniform" Height="42"/><TextBlock Text="{loc:Translate ui.tur_otobusu}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource ModernButton}" Margin="4" Padding="6" Width="130" Height="90" Click="SpawnVehicleSelect_Click" Tag="bus|intercity">
                                                <StackPanel><Image Source="pack://siteoforigin:,,,/Assets/Vehicles/bus/bus_intercity.png" Stretch="Uniform" Height="42"/><TextBlock Text="{loc:Translate ui.sehirlerarasi_otobus}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource ModernButton}" Margin="4" Padding="6" Width="130" Height="90" Click="SpawnVehicleSelect_Click" Tag="bus|midi">
                                                <StackPanel><Image Source="pack://siteoforigin:,,,/Assets/Vehicles/bus/bus_midi.png" Stretch="Uniform" Height="42"/><TextBlock Text="{loc:Translate ui.midibus}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel>
                                            </Button>
                                        </WrapPanel>

                                        <TextBlock Text="{loc:Translate ui.traktorler}" FontFamily="{StaticResource PixelFont}" FontSize="10" FontWeight="Bold" Foreground="#001F5B" Margin="2,10,0,4"/>
                                        <WrapPanel>
                                            <Button Style="{StaticResource ModernButton}" Margin="4" Padding="6" Width="130" Height="90" Click="SpawnVehicleSelect_Click" Tag="tractor|farm">
                                                <StackPanel><Image Source="pack://siteoforigin:,,,/Assets/Vehicles/tractor/tractor_farm.png" Stretch="Uniform" Height="42"/><TextBlock Text="{loc:Translate ui.tarim_traktoru}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" FontWeight="Bold" TextWrapping="Wrap"/></StackPanel>
                                            </Button>
                                        </WrapPanel>

                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- SAĞ: Ekipman ve Dorse Galerisi -->
                        <Border Grid.Column="2" Background="#EDEDF5" BorderThickness="3" BorderBrush="#000000">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="#001F5B" BorderThickness="0,0,0,3" BorderBrush="#000000" Padding="10,8">
                                    <TextBlock Text="{loc:Translate ui.ekipman_ve_dorse_galerisi}" FontFamily="{StaticResource PixelFont}" FontSize="10" FontWeight="Black" Foreground="#1ABCAA" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10">
                                    <TextBlock Text="{loc:Translate ui.bir_araci_ekledikten_sonra_secili_arac}" FontSize="10" Foreground="#333333" TextWrapping="Wrap" Margin="2,0,2,10"/>

                                    <Border Background="#FFFFFF" BorderThickness="2" BorderBrush="#000000" Padding="8" Margin="0,0,0,8">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Image Source="pack://siteoforigin:,,,/Assets/Vehicles/trailer/trailer_flatbed.png" Stretch="Uniform" Height="36"/>
                                            <TextBlock Text="{loc:Translate ui.tir_dorse_1_duz_yatak}" FontSize="10" FontWeight="Black" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#FFFFFF" BorderThickness="2" BorderBrush="#000000" Padding="8" Margin="0,0,0,8">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Image Source="pack://siteoforigin:,,,/Assets/Vehicles/trailer/trailer_tanker.png" Stretch="Uniform" Height="36"/>
                                            <TextBlock Text="{loc:Translate ui.tir_dorse_2_sivi_tanker}" FontSize="10" FontWeight="Black" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#FFFFFF" BorderThickness="2" BorderBrush="#000000" Padding="8" Margin="0,0,0,8">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Image Source="pack://siteoforigin:,,,/Assets/Vehicles/trailer/trailer_equipment.png" Stretch="Uniform" Height="36"/>
                                            <TextBlock Text="{loc:Translate ui.traktor_romorku_1}" FontSize="10" FontWeight="Black" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#FFFFFF" BorderThickness="2" BorderBrush="#000000" Padding="8">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Image Source="pack://siteoforigin:,,,/Assets/Vehicles/trailer/trailer_wagon.png" Stretch="Uniform" Height="36"/>
                                            <TextBlock Text="{loc:Translate ui.traktor_romorku_2}" FontSize="10" FontWeight="Black" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Footer / Close -->
                    <Button Grid.Row="2" Content="{loc:Translate ui.iptal}" Click="CloseSpawnModal_Click" Style="{StaticResource ModernButton}" Width="100" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Yardım / Kısayollar Modali: her an "❓" butonuyla açılabilen kalıcı kısayol referansı -
             önceden genel kısayollar (T/M/R/C/S/L/E/V/K/A/G) hiçbir yerde gösterilmiyordu, sadece
             Vites panelindeki sürüşe özel kısayollar görünürdü. -->
        <Grid Name="HelpModal" Visibility="Collapsed" Background="#90000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Kısayol listesi İngilizceye geçince okunamaz hale gelmişti. İki kök sebep vardı:
                 (1) Gövde metinlerinde açık Foreground YOKTU; pencere kökünden BEYAZ miras alınıyor,
                     krem (#FFFFCC) zeminde görünmez oluyordu.
                 (2) Pencere kökündeki TextElement.FontFamily mirası "Press Start 2P" pixel fontu;
                     bu font çok geniş ve satır kutusu glif yüksekliğinden dar olduğundan, uzun
                     İngilizce satırlar sarınca ALT ALTA BİNİYORDU.
                 Çözüm: gövde metinleri artık koyu renkli, okunaklı bir sistem fontuyla ve GARANTİ
                 satır yüksekliğiyle (LineHeight + BlockLineHeight) çiziliyor; kutu da uzun çeviriler
                 için genişletildi. Başlıklar pixel fontunu koruyor (tasarım dili bozulmasın). -->
            <Border Name="HelpModalBox" Width="560" Height="560" Background="#FFFFCC" CornerRadius="0" BorderThickness="4" BorderBrush="#000000" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="0" ShadowDepth="8" Opacity="1" Color="#000000" Direction="315"/>
                </Border.Effect>
                <Grid>
                    <Grid.Resources>
                        <!-- Kısayol satırlarının ortak stili: koyu renk (kontrast), okunaklı font ve
                             sarma durumunda bile sabit satır aralığı (satır yüksekliği kuralı
                             Styles.xaml'deki GuaranteedLineHeight'tan gelir). -->
                        <Style x:Key="HelpLine" TargetType="TextBlock" BasedOn="{StaticResource GuaranteedLineHeight}">
                            <Setter Property="FontFamily" Value="Segoe UI, Arial"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#111827"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Margin" Value="0,0,0,7"/>
                        </Style>
                    </Grid.Resources>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{loc:Translate ui.kisayollar}" FontFamily="{StaticResource PixelFont}" FontSize="10" FontWeight="Black" Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <!-- Dil geçiş butonu: karşı dilin adını gösterir, tıklanınca arayüzün
                             tamamı yeniden başlatma olmadan anında o dile geçer. -->
                        <Button Name="HelpLanguageToggleBtn" Click="HelpLanguageToggle_Click" Style="{StaticResource ModernButton}"
                                Height="26" Padding="10,0" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Center"
                                ToolTip="{loc:Translate ui.arayuz_dilini_degistir}" AutomationProperties.Name="{loc:Translate ui.dil}"/>
                        <Button Content="✕" Click="CloseHelpModal_Click" Style="{StaticResource IconButton}" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Style="{StaticResource BeytriumScrollViewer}">
                        <StackPanel Margin="4,0,10,0">
                            <TextBlock Text="{loc:Translate ui.genel}" FontFamily="{StaticResource PixelFont}" FontSize="9" FontWeight="Bold" Foreground="#001F5B" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Translate ui.r_arac_ekle_c_temizle_delete}" Style="{StaticResource HelpLine}"/>
                            <TextBlock Text="{loc:Translate ui.ctrls_kaydet_l_yukle_e_eklentiler}" Style="{StaticResource HelpLine}"/>
                            <TextBlock Text="{loc:Translate ui.q_secili_araci_imlece_cagir}" Style="{StaticResource HelpLine}"/>
                            <TextBlock Text="{loc:Translate ui.t_tema_degistir_m_ses_ac}" Style="{StaticResource HelpLine}"/>
                            <TextBlock Text="{loc:Translate ui.a_otomatik_hareket_ac_kapa_g}" Style="{StaticResource HelpLine}"/>
                            <TextBlock Text="{loc:Translate ui.v_ucus_modu_secili_arac_k}" Style="{StaticResource HelpLine}"/>
                            <TextBlock Text="{loc:Translate ui.p_duraklat_w_basilisurt_arac_yika}" Style="{StaticResource HelpLine}"/>
                            <TextBlock Text="{loc:Translate ui.shifttik_secili_arac_lar_a_rota}" Style="{StaticResource HelpLine}" Margin="0,0,0,14"/>

                            <TextBlock Text="{loc:Translate ui.surus_modu}" FontFamily="{StaticResource PixelFont}" FontSize="9" FontWeight="Bold" Foreground="#001F5B" Margin="0,0,0,8"/>
                            <TextBlock Text="{loc:Translate ui.bosluk_surus_modunu_ac_kapa}" Style="{StaticResource HelpLine}"/>
                            <TextBlock Text="{loc:Translate ui.wasd_ok_tuslari_sur_fren}" Style="{StaticResource HelpLine}"/>
                            <TextBlock Text="{loc:Translate ui.0_9_vites_sec_x_range}" Style="{StaticResource HelpLine}"/>
                            <TextBlock Text="{loc:Translate ui.tab_surulen_araci_degistir}" Style="{StaticResource HelpLine}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="{loc:Translate ui.kapat}" Click="CloseHelpModal_Click" Style="{StaticResource ModernButton}" Width="100" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Kayıt Listesi Modali (Save List) -->
        <Grid Name="SaveListModal" Visibility="Collapsed" Background="#90000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Name="SaveListModalBox" Width="480" Height="420" Background="#FFFFCC" CornerRadius="0" BorderThickness="4" BorderBrush="#000000" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="0" ShadowDepth="8" Opacity="1" Color="#000000" Direction="315"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{loc:Translate ui.kayitlar}" FontFamily="{StaticResource PixelFont}" FontSize="10" FontWeight="Black" Foreground="#000000" HorizontalAlignment="Center"/>
                        <Button Content="✕" Click="CloseSaveListModal_Click" Style="{StaticResource IconButton}" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Style="{StaticResource BeytriumScrollViewer}">
                        <ItemsControl Name="SaveListControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#12233F" BorderThickness="2" BorderBrush="#000000" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="{Binding Timestamp, StringFormat='dd.MM.yyyy HH:mm:ss'}" FontSize="10" Foreground="#C9D6E8" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding VehicleCount, StringFormat='🚗 {0} araç'}" FontSize="10" Foreground="#95E1D3" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="📂" Tag="{Binding Name}" Click="LoadSaveRow_Click" Style="{StaticResource IconButton}" Width="30" Height="30" Margin="4,0" ToolTip="{loc:Translate ui.bu_kaydi_yukle}" AutomationProperties.Name="{loc:Translate ui.bu_kaydi_yukle}"/>
                                            <Button Grid.Column="2" Content="🗑" Tag="{Binding Name}" Click="DeleteSaveRow_Click" Style="{StaticResource IconButtonClose}" Width="30" Height="30" ToolTip="{loc:Translate ui.bu_kaydi_sil}" AutomationProperties.Name="{loc:Translate ui.bu_kaydi_sil}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="{loc:Translate ui.kapat}" Click="CloseSaveListModal_Click" Style="{StaticResource ModernButton}" Width="100" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Özel Sorgu ve Mesaj Modali (Custom Dialog Overlay) -->
        <Grid Name="CustomDialogOverlay" Visibility="Collapsed" Background="#90000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Name="CustomDialogBox" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#FFFFCC" BorderThickness="4" BorderBrush="#000000" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="0" ShadowDepth="8" Opacity="1" Color="#000000" Direction="315"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title Bar -->
                    <Border Grid.Row="0" Background="#fbca1f" BorderThickness="0,0,0,4" BorderBrush="#000000" Margin="-20,-20,-20,15" Padding="15,10">
                        <TextBlock Name="CustomDialogTitle" Text="{loc:Translate ui.sorgu_mesaj}" FontFamily="Oswald, Impact, Arial Black, Segoe UI, Segoe UI Emoji" FontSize="16" FontWeight="Black" Foreground="#000000"/>
                    </Border>

                    <!-- Message Body -->
                    <TextBlock Name="CustomDialogMessage" Grid.Row="1" Text="{loc:Translate ui.buraya_mesaj_icerigi_gelecek}" Foreground="#000000" FontSize="10" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10,0,20"/>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Name="CustomDialogYesBtn" Content="{loc:Translate ui.evet}" Click="CustomDialogYes_Click" Style="{StaticResource ModernButton}" Background="#fbca1f" Width="100" Margin="0,0,10,0"/>
                        <Button Name="CustomDialogNoBtn" Content="{loc:Translate ui.hayir}" Click="CustomDialogNo_Click" Style="{StaticResource ModernButton}" Background="#1ABCAA" Width="100" Margin="0,0,10,0"/>
                        <Button Name="CustomDialogOkBtn" Content="{loc:Translate ui.tamam}" Click="CustomDialogOk_Click" Style="{StaticResource ModernButton}" Background="#fbca1f" Width="100"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
