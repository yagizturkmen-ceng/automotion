                        <Button Name="ItemShopScaleUpBtn" Content="➕" Click="PanelScaleUp_Click" Tag="{Binding ElementName=ItemShopPanel}" Style="{StaticResource IconButton}" Width="20" Height="20" Margin="1,0" FontSize="10" ToolTip="{loc:Translate ui.paneli_buyut}" AutomationProperties.Name="{loc:Translate ui.paneli_buyut}"/>
                        <Button Name="ItemShopPinBtn" Content="📌" Click="PanelPin_Click" Tag="{Binding ElementName=ItemShopPanel}" Style="{StaticResource IconButton}" Width="20" Height="20" Margin="1,0" FontSize="10" ToolTip="{loc:Translate ui.sabitle}" AutomationProperties.Name="{loc:Translate ui.sabitle}"/>
                        <Button Name="ItemShopDetachBtn" Content="↗️" Click="PanelDetach_Click" Tag="{Binding ElementName=ItemShopPanel}" Style="{StaticResource IconButton}" Width="20" Height="20" Margin="1,0" FontSize="10" ToolTip="{loc:Translate ui.panelden_ayir_bagimsiz_pencereye_cikar}" AutomationProperties.Name="{loc:Translate ui.panelden_ayir}"/>
