                                <Border Background="#12233F" BorderThickness="2" BorderBrush="#000000" CornerRadius="0" Padding="10" Margin="0,0,10,10" Width="150">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Icon}" FontSize="24" HorizontalAlignment="Center"/>
