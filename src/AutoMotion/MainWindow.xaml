                                        <Button Content="{loc:Translate ui.kullan}" Tag="{Binding}" Click="UseItemBtn_Click" Style="{StaticResource ModernButton}" FontSize="9" Padding="4,4" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
